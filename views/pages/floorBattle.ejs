<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#181c28">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="ThirdWorld">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <script>if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () {});</script>

  <title>ThirdWorld - 전투</title>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    /* 전투 연출 */
    .rb-status { position: relative; }
    .fx-float { position: absolute; right: 4px; top: -6px; font-weight: 700; font-size: 15px; pointer-events: none; animation: fxFloat .9s ease-out forwards; z-index: 5; text-shadow: 0 1px 2px #000; }
    .fx-float.dmg { color: #ff6b6b; } .fx-float.crit { color: #ffa552; font-size: 19px; } .fx-float.heal { color: #5cd67a; } .fx-float.shield { color: #6bb7ff; font-size: 13px; } .fx-float.status { color: #d9a3ff; font-size: 12px; animation-duration: 1.3s; }
    @keyframes fxFloat { 0% { opacity: 0; transform: translateY(6px); } 15% { opacity: 1; } 100% { opacity: 0; transform: translateY(-22px); } }
    .fx-hurt { animation: fxHurt .45s; } .fx-hurt.crit { animation: fxHurtBig .55s; }
    @keyframes fxHurt { 0%,100% { transform: translateX(0); } 20% { transform: translateX(-5px); } 40% { transform: translateX(5px); } 60% { transform: translateX(-3px); } 80% { transform: translateX(3px); } }
    @keyframes fxHurtBig { 0%,100% { transform: translate(0,0); } 15% { transform: translate(-8px,2px); } 30% { transform: translate(8px,-2px); } 45% { transform: translate(-6px,1px); } 60% { transform: translate(6px,-1px); } 80% { transform: translate(-3px,0); } }
    .fx-flash { animation: fxFlash .4s; } @keyframes fxFlash { 0% { box-shadow: inset 0 0 0 100px rgba(255,80,80,.35); } 100% { box-shadow: none; } }
    .fx-heal { animation: fxHealFlash .5s; } @keyframes fxHealFlash { 0% { box-shadow: inset 0 0 0 100px rgba(80,220,120,.3); } 100% { box-shadow: none; } }
    .charItem button.fx-win { animation: fxWin .5s; } @keyframes fxWin { 0% { box-shadow: 0 0 0 0 var(--brass); } 40% { box-shadow: 0 0 14px 3px var(--brass); } 100% { box-shadow: none; } }
    .charItem button.fx-lose { animation: fxLose .5s; } @keyframes fxLose { 0% { opacity: 1; } 40% { opacity: .35; } 100% { opacity: 1; } }
    .fx-stamp { position: fixed; left: 50%; top: 42%; transform: translate(-50%,-50%) scale(.6) rotate(-8deg); font-size: 24px; font-weight: 900; color: var(--brass); border: 2px solid var(--brass); padding: 4px 14px; border-radius: 8px; background: rgba(24,28,40,.85); pointer-events: none; z-index: 50; animation: fxStamp .7s ease-out forwards; letter-spacing: 4px; }
    @keyframes fxStamp { 0% { opacity: 0; transform: translate(-50%,-50%) scale(1.6) rotate(-8deg); } 25% { opacity: 1; transform: translate(-50%,-50%) scale(1) rotate(-8deg); } 75% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%,-50%) scale(1) rotate(-8deg); } }
    .fx-stamp.sp-me { color: #e9d7ff; border-color: #c98bff; box-shadow: 0 0 24px rgba(201,139,255,.6); font-size: 20px; letter-spacing: 1px; padding: 4px 14px; top: 68%; animation: fxSpecial 1.1s ease-out forwards; }
    .fx-stamp.sp-enemy { color: #ffd0d0; border-color: #ff6b6b; box-shadow: 0 0 24px rgba(255,107,107,.55); font-size: 20px; letter-spacing: 1px; padding: 4px 14px; top: 22%; animation: fxSpecial 1.1s ease-out forwards; }
    @keyframes fxSpecial { 0% { opacity: 0; transform: translate(-50%,-50%) scale(.4) rotate(0); filter: blur(4px); } 20% { opacity: 1; transform: translate(-50%,-50%) scale(1.08) rotate(0); filter: blur(0); } 30% { transform: translate(-50%,-50%) scale(1) rotate(0); } 80% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%,-60%) scale(1) rotate(0); } }
    .fx-special { animation: fxSpGlow 1.1s; } @keyframes fxSpGlow { 0% { box-shadow: 0 0 0 0 rgba(201,139,255,0); } 30% { box-shadow: 0 0 24px 4px rgba(201,139,255,.7); } 100% { box-shadow: none; } }
    .enemyWrap.fx-special { animation: fxSpGlowE 1.1s; } @keyframes fxSpGlowE { 0% { box-shadow: none; } 30% { box-shadow: 0 0 24px 4px rgba(255,107,107,.7); } 100% { box-shadow: none; } }
    .fx-stamp.end { top: 45%; font-size: 34px; letter-spacing: 4px; padding: 8px 22px; border-width: 3px; }
    @media (prefers-reduced-motion: reduce) { .fx-float, .fx-hurt, .fx-flash, .fx-heal, .fx-special, .fx-stamp, .charItem button.fx-win, .charItem button.fx-lose { animation: none !important; } }
  </style>
</head>
<body>
  <div class="rps-bar enemyWrap">
    <div class="rb-enemy"><b class="<%= enemy.isBoss ? 'colorGold' : '' %>"><%= enemy.name %></b> <span style="color:var(--ash);font-size:12px"><%= enemy.title %><% if (enemy.deck) { %> · 덱 <%= enemy.deck.length %>장<% } %></span></div>
    <div class="rb-status">
      <div class="bar hp"><i id="ehpBar"></i></div><span class="num" id="ehpNum"></span>
      <div class="bar sp" id="espWrap"><i id="espBar"></i></div><span class="num" id="espNum"></span>
    </div>
    <div class="charItem"><button id="enemyBtn0" disabled type="button">[가위]<br></button></div>
    <div class="charItem"><button id="enemyBtn1" disabled type="button">[바위]<br></button></div>
    <div class="charItem"><button id="enemyBtn2" disabled type="button">[보]<br></button></div>
  </div>
  <div id="result" class="rps-result battle-log"></div>
  <div class="rps-bar selectWrap">
    <div class="rb-status">
      <div class="bar hp"><i id="hpBar"></i></div><span class="num" id="hpNum"></span>
      <div class="bar sp" id="spWrap"><i id="spBar"></i></div><span class="num" id="spNum"></span>
    </div>
    <div class="rb-tools"><span id="deckInfo"></span><span><button id="itemBtn" type="button" disabled>소모품</button> <span id="useBtns"></span> <button id="swapBtn" type="button" style="display:none" disabled>바꿔치기</button> <button id="undoBtn" type="button" style="display:none" disabled>무르기</button> <button id="redrawBtn" type="button" style="display:none" disabled>손패 교체</button> <button id="resetBtn" type="button" disabled>덱 리셋</button></span></div>
    <div class="rb-items" id="itemList" style="display:none"></div>
    <div class="charItem"><button id="handBtn0" type="button" disabled></button></div>
    <div class="charItem"><button id="handBtn1" type="button" disabled></button></div>
    <div class="charItem"><button id="handBtn2" type="button" disabled></button></div>
    <div class="charItem" id="handWrap3" style="display:none"><button id="handBtn3" type="button" disabled></button></div>
  </div>
<script>
  var socket = io();
  var names = ['', '', ''];
  var glyph = ['[가위]', '[바위]', '[보]'];
  var hand = [];
  // 고정 바 높이에 맞춰 로그 여백 조정
  function fitPadding() {
    var r = document.getElementById('result');
    r.style.paddingTop = (document.querySelector('.enemyWrap').offsetHeight + 12) + 'px';
    r.style.paddingBottom = (document.querySelector('.selectWrap').offsetHeight + 24) + 'px';
  }
  window.addEventListener('resize', fitPadding);
  window.addEventListener('load', fitPadding);
  function bar(id, cur, max) {
    document.getElementById(id + 'Bar').style.width = (max > 0 ? Math.min(100, 100 * cur / max) : 0) + '%';
    document.getElementById(id + 'Num').textContent = cur + ' / ' + max;
  }
  var items = [], itemsOpen = false;
  function renderItems() {
    var box = document.getElementById('itemList'), btn = document.getElementById('itemBtn');
    btn.textContent = '소모품 (' + items.length + ')';
    if (items.length) btn.removeAttribute('disabled'); else { btn.setAttribute('disabled', true); itemsOpen = false; }
    box.style.display = itemsOpen && items.length ? '' : 'none';
    box.innerHTML = '';
    items.forEach(function (it) {
      var b = document.createElement('button'); b.type = 'button';
      b.innerHTML = '<b>' + it.name + (it.temp ? ' <span style="color:var(--brass)">(임시)</span>' : '') + '</b><br><small>' + (it.tooltip || '').replace('전투 중 사용: ', '') + '</small>';
      b.addEventListener('click', function () {
        itemsOpen = false; renderItems(); lockHand();
        if (it.card !== undefined && it.card !== null) socket.emit('floorSelect', '<%= room %>', '<%= uid %>', it.card, it.i);
        else socket.emit('floorUse', '<%= room %>', '<%= uid %>', it.i);
      });
      box.appendChild(b);
    });
    fitPadding();
  }
  document.getElementById('itemBtn').addEventListener('click', function () { itemsOpen = !itemsOpen; renderItems(); });
  var curState = null;
  var lastFxTurn = -1;
  function fxFloat(which, text, cls, row) {   // which: 'me' | 'enemy'; row: 겹치지 않게 줄 나누기
    var host = document.querySelector(which === 'me' ? '.selectWrap .rb-status' : '.enemyWrap .rb-status'); if (!host) return;
    var el = document.createElement('span'); el.className = 'fx-float ' + cls; el.textContent = text; if (row) el.style.top = (-6 + row * 18) + 'px'; host.appendChild(el);
    setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 950);
  }
  function fxPanel(which, cls) {
    var host = document.querySelector(which === 'me' ? '.selectWrap' : '.enemyWrap'); if (!host) return;
    host.classList.remove('fx-hurt', 'fx-flash', 'fx-heal', 'fx-special', 'crit'); void host.offsetWidth;
    cls.split(' ').forEach(function (c) { host.classList.add(c); });
    setTimeout(function () { host.classList.remove('fx-hurt', 'fx-flash', 'fx-heal', 'fx-special', 'crit'); }, 1100);
  }
  function fxStamp(text, cls) {
    var el = document.createElement('div'); el.className = 'fx-stamp' + (cls ? ' ' + cls : ''); el.textContent = text; document.body.appendChild(el);
    setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, cls ? 1100 : 720);
  }
  function fxCards(myKey, eKey, outcome) {   // outcome: 1 내가 이김, -1 짐, 0 비김
    var mine = document.getElementById('handBtn' + lastPlayedIdx), his = document.getElementById('enemyBtn' + eKey);
    [mine, his].forEach(function (b) { if (b) { b.classList.remove('fx-win', 'fx-lose'); void b.offsetWidth; } });
    if (outcome === 1) { if (mine) mine.classList.add('fx-win'); if (his) his.classList.add('fx-lose'); }
    else if (outcome === -1) { if (his) his.classList.add('fx-win'); if (mine) mine.classList.add('fx-lose'); }
    setTimeout(function () { [mine, his].forEach(function (b) { if (b) b.classList.remove('fx-win', 'fx-lose'); }); }, 600);
  }
  function playFx(prev, s, resultHtml) {
    if (!prev || !s || !resultHtml || skipFx) return;
    var txt = resultHtml.replace(/<[^>]+>/g, ' ');
    var turnM = txt.match(/(\d+)턴\s*$/) || null;   // (참고용)
    var lastTurn = resultHtml.lastIndexOf('turnWrap');
    var tail = lastTurn >= 0 ? resultHtml.slice(lastTurn).replace(/<[^>]+>/g, ' ') : txt;
    var crit = /\(치명타\)/.test(tail);
    var dHp = s.hp[0] - prev.hp[0], dEhp = s.ehp[0] - prev.ehp[0];
    if (dHp < 0) { fxFloat('me', '-' + Math.round(-dHp), crit && /공격해[^]*?치명타/.test(tail) ? 'dmg crit' : 'dmg'); fxPanel('me', 'fx-hurt fx-flash' + (crit ? ' crit' : '')); }
    else if (dHp > 0) { fxFloat('me', '+' + Math.round(dHp), 'heal'); fxPanel('me', 'fx-heal'); }
    if (dEhp < 0) { fxFloat('enemy', '-' + Math.round(-dEhp), crit ? 'dmg crit' : 'dmg'); fxPanel('enemy', 'fx-hurt fx-flash' + (crit ? ' crit' : '')); }
    else if (dEhp > 0) { fxFloat('enemy', '+' + Math.round(dEhp), 'heal'); fxPanel('enemy', 'fx-heal'); }
    if (/비겼습니다/.test(tail) && !/공격해/.test(tail)) fxStamp('무승부!');
    // 보호막 흡수: 서버가 표시한 대상(data-who)으로 집계
    var lastHtml = lastTurn >= 0 ? resultHtml.slice(lastTurn) : resultHtml;
    var shMe = 0, shEn = 0, shRe = /data-who="([LR])" data-amt="(\d+)"/g, m2;
    while ((m2 = shRe.exec(lastHtml))) { if (m2[1] === 'L') shMe += +m2[2]; else shEn += +m2[2]; }
    if (shMe) fxFloat('me', '⛨ ' + shMe, 'shield', 1); if (shEn) fxFloat('enemy', '⛨ ' + shEn, 'shield', 1);
    // 상태이상: 이름이 정확히 붙은 문장만
    var STD = ['화상', '중독', '출혈', '기절', '수면', '마비', '침묵', '암흑', '봉인', '광란', '빙결'];
    var myName = s.myName || '', enName = '<%= enemy.name %>';
    var gotMe = [], gotEn = [];
    STD.forEach(function (nm) {
      if (myName && (tail.indexOf(myName + '은 [ ' + nm + ' ] 효과를 받았습니다') >= 0 || tail.indexOf(myName + '는 [ ' + nm + ' ] 효과를 받았습니다') >= 0)) gotMe.push(nm);
      if (tail.indexOf(enName + '은 [ ' + nm + ' ] 효과를 받았습니다') >= 0 || tail.indexOf(enName + '는 [ ' + nm + ' ] 효과를 받았습니다') >= 0) gotEn.push(nm);
    });
    if (gotMe.length) fxFloat('me', gotMe.join(' · '), 'status', 2);
    if (gotEn.length) fxFloat('enemy', gotEn.join(' · '), 'status', 2);
    var spM = tail.match(/\[ ([^\]]+?) \] Special Skill - \[ ([^\]]+?) \]/);   // 스페셜 발동
    if (spM) { var mine = spM[1].trim() !== '<%= enemy.name %>'; fxStamp(spM[2].trim(), mine ? 'sp-me' : 'sp-enemy'); fxPanel(mine ? 'me' : 'enemy', 'fx-special'); }
    var eKey = s.lastEKey; if (typeof eKey === 'number' && lastPlayedIdx >= 0) {
      var out = (lastPlayedKey - eKey + 3) % 3; fxCards(lastPlayedKey, eKey, out === 0 ? 0 : (out === 1 ? 1 : -1));   // 가위0>보2, 바위1>가위0, 보2>바위1 → (내-적+3)%3==1 이면 승
    }
  }
  var skipFx = false, lastPlayedIdx = -1, lastPlayedKey = -1;
  function renderState(s) {
    var prev = curState;
    curState = s;
    try { playFx(prev, s, pendingResult); } catch (e) {}
    pendingResult = null;
    if (s.names) names = s.names;                 // 전투 중 스킬 교체 반영
    if (s.enemyNames) oNames = s.enemyNames;
    items = s.items || []; renderItems();
    bar('hp', s.hp[0], s.hp[1]); bar('ehp', s.ehp[0], s.ehp[1]);
    bar('sp', s.sp[0], s.sp[1]); bar('esp', s.esp[0], s.esp[1]);
    document.getElementById('spWrap').className = 'bar sp' + (s.sp[1] > 0 && s.sp[0] >= s.sp[1] ? ' ready' : '');
    document.getElementById('espWrap').className = 'bar sp' + (s.esp[1] > 0 && s.esp[0] >= s.esp[1] ? ' ready' : '');
    for (var i = 0; i < 3; i++) {
      var b = document.getElementById('enemyBtn' + i);
      var hint = '';
      if (s.ehint && s.ehint.type === 'one' && s.ehint.card === i) hint = ' <span style="color:var(--brass)">손패 ◆</span>';
      if (s.ehint && s.ehint.type === 'major' && s.ehint.cards.indexOf(i) >= 0) hint = ' <span style="color:var(--brass)">손패 ▲</span>';
      if (s.ehint && s.ehint.type === 'all') { var n = s.ehint.cards.filter(function (c) { return c === i; }).length; if (n) hint = ' <span style="color:var(--brass)">손패 ' + n + '</span>'; }
      if (s.predict && s.predict.key === i) hint += ' <span style="color:#7fb8ff" title="' + s.predict.name + '">다음 수? ◎</span>';
      b.innerHTML = glyph[i] + ' <span class="colorGold">×' + oDeckCnt[i] + '</span>' + (s.eplayed[i] ? ' <span style="color:var(--ash)">낸 ' + s.eplayed[i] + '</span>' : '') + hint + '<br>' + oNames[i];
    }
    var ub0 = document.getElementById('useBtns'); ub0.innerHTML = '';
    if (s.manualSp) {   // 수동의 미학
      var spb = document.createElement('button'); spb.type = 'button';
      spb.textContent = s.manualSp.armed ? '[스페셜] 예약됨 ✓' : '[스페셜] ' + s.manualSp.name;
      if (s.manualSp.sp < s.manualSp.cost && !s.manualSp.armed) { spb.setAttribute('disabled', true); spb.textContent += ' (' + s.manualSp.sp + '/' + s.manualSp.cost + ')'; }
      if (s.manualSp.armed) spb.style.borderColor = 'var(--brass)';
      spb.addEventListener('click', function () { this.setAttribute('disabled', true); socket.emit('floorSpecial', '<%= room %>', '<%= uid %>'); });
      ub0.appendChild(spb);
    }
    (s.uses || []).forEach(function (u) {
      var b = document.createElement('button'); b.type = 'button';
      var off = u.cd > 0 || (u.left !== null && u.left <= 0);
      b.textContent = '[사용] ' + u.label + (u.cd > 0 ? ' (쿨 ' + u.cd + ')' : (u.left !== null ? ' (' + u.left + ')' : ''));
      b.title = u.name;
      if (off) b.setAttribute('disabled', true);
      b.addEventListener('click', function () { this.setAttribute('disabled', true); socket.emit('floorItemUse', '<%= room %>', '<%= uid %>', u.slot); });
      ub0.appendChild(b);
    });
    var sw = document.getElementById('swapBtn');
    sw.style.display = s.swaps > 0 ? '' : 'none';
    sw.textContent = '바꿔치기 (' + s.swaps + ')';
    if (s.swaps > 0) sw.removeAttribute('disabled'); else sw.setAttribute('disabled', true);
    var ub = document.getElementById('undoBtn');
    ub.style.display = s.undos > 0 ? '' : 'none';
    ub.textContent = '무르기 (' + s.undos + ')';
    if (s.undos > 0) ub.removeAttribute('disabled'); else ub.setAttribute('disabled', true);
    var dr = document.getElementById('redrawBtn');
    dr.style.display = s.redraws > 0 ? '' : 'none';
    dr.textContent = '손패 교체 (' + s.redraws + ')';
    if (s.redraws > 0) dr.removeAttribute('disabled'); else dr.setAttribute('disabled', true);
    var rb = document.getElementById('resetBtn');
    rb.textContent = '덱 리셋 (' + s.resets + ')';
    if (s.resets > 0) rb.removeAttribute('disabled'); else rb.setAttribute('disabled', true);
    renderHand(s.hand, s.draw, s.discard);
    fitPadding();
  }
  var oNames = ['', '', ''], oDeckCnt = [0, 0, 0];
  function renderHand(types, drawN, discardN) {
    hand = types;
    document.getElementById('handWrap3').style.display = types.length > 3 ? '' : 'none';
    for (var i = 0; i < 4; i++) {
      var b = document.getElementById('handBtn' + i);
      if (i < types.length) {
        b.innerHTML = glyph[types[i]] + '<br>' + names[types[i]];
        if (curState && curState.banned !== null && curState.banned !== undefined && curState.banned === types[i]) { b.setAttribute('disabled', true); b.style.opacity = '.4'; b.title = '필치 봉쇄 — 이번 턴에는 낼 수 없다'; }
        b.className = 'card-t' + types[i];
        b.removeAttribute('disabled');
      } else {
        b.innerHTML = '';
        b.className = '';
        b.setAttribute('disabled', true);
      }
    }
    document.getElementById('deckInfo').textContent = '덱 ' + drawN + ' · 버림 ' + discardN;
  }
  function lockHand() { for (var i = 0; i < 4; i++) document.getElementById('handBtn' + i).setAttribute('disabled', true); }
  for (var i = 0; i < 4; i++) (function (i) {
    document.getElementById('handBtn' + i).addEventListener('click', function () {
      if (i >= hand.length) return;
      lockHand();
      lastPlayedIdx = i; lastPlayedKey = hand[i];
      socket.emit('floorSelect', '<%= room %>', '<%= uid %>', hand[i]);
    });
  })(i);
  document.getElementById('swapBtn').addEventListener('click', function () {
    var v = prompt('바꿀 두 슬롯 (예: 1 3 — 1 가위, 2 바위, 3 보)');
    if (!v) return; var m = v.match(/([123])\D+([123])/); if (!m) return;
    this.setAttribute('disabled', true);
    socket.emit('floorSwap', '<%= room %>', '<%= uid %>', parseInt(m[1]) - 1, parseInt(m[2]) - 1);
  });
  document.getElementById('undoBtn').addEventListener('click', function () {
    skipFx = true; setTimeout(function () { skipFx = false; }, 1500);
    this.setAttribute('disabled', true);
    socket.emit('floorUndo', '<%= room %>', '<%= uid %>');
  });
  document.getElementById('redrawBtn').addEventListener('click', function () {
    this.setAttribute('disabled', true);
    socket.emit('floorRedraw', '<%= room %>', '<%= uid %>');
  });
  document.getElementById('resetBtn').addEventListener('click', function () {
    this.setAttribute('disabled', true);
    socket.emit('floorReset', '<%= room %>', '<%= uid %>');
  });
  socket.emit('floorInit', '<%= room %>', '<%= uid %>');
  socket.on('floorAck', function (result, myNames, enemyNames, state, oDeck) {
    document.getElementById('result').innerHTML = result;
    names = myNames; oNames = enemyNames; oDeckCnt = oDeck;
    renderState(state);
  });
  var pendingResult = null;
  socket.on('floorSelectAck', function (result, state, newNames) {
    if (newNames) names = newNames;
    pendingResult = result;
    if (result !== null) document.getElementById('result').innerHTML = result;
    if (state) renderState(state); else { for (var i = 0; i < 4; i++) document.getElementById('handBtn' + i).removeAttribute('disabled'); }
    if (result !== null) window.scrollTo(0, document.body.scrollHeight);
  });
  socket.on('floorFled', function () {
    document.getElementById('result').innerHTML += '<div class="note-box">연막이 퍼진다. 물러난다...</div>';
    lockHand();
    var f = document.createElement('form'); f.method = 'post'; f.action = '/floorFlee'; document.body.appendChild(f);
    setTimeout(function () { f.submit(); }, 700);
  });
  socket.on('floorSelectEnd', function (result, state) {
    document.getElementById('result').innerHTML = result + '<div class="backLink"><a href="/floorResult" class="btn-primary" style="padding:12px 24px">결과 보기</a></div>';
    if (state) { pendingResult = result; try { renderState(state); } catch (e) {} }   // 마지막 턴도 체력 바·연출 반영
    var won = !!(state && state.myName) && result.indexOf(state.myName + '의 승리입니다') >= 0;
    setTimeout(function () { fxStamp(won ? '승리!' : '패배', won ? 'sp-me end' : 'sp-enemy end'); }, 450);
    lockHand(); document.getElementById('resetBtn').setAttribute('disabled', true); document.getElementById('redrawBtn').setAttribute('disabled', true); items = []; renderItems();
    window.scrollTo(0, document.body.scrollHeight);
  });
</script>
<script src="/js/ui.js"></script>
</body>
</html>
