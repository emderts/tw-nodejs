<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#181c28">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="ThirdWorld">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <script>if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () {});</script>

  <script src="/socket.io/socket.io.js"></script>
    <script>
  function invClick(thisNode, event) {
    if (thisNode.type !== 'submit') {
      event.preventDefault();
      for (item of document.getElementsByClassName('inventoryButton')) {
        item.type = 'button';
      }
      thisNode.setAttribute('type', 'submit');
    }
  }
  
  var socket = io();
  socket.emit('login', '<%= user.name %>', '<%= user.uid %>', '<%= char.raidSide %>');
  
  function sendMessage() {
    var el = document.getElementById('msg'); if (!el) return false;
    socket.emit('chat message', el.value);
    el.value = '';
    return false;
  };
  
  socket.on('logged in', function(chatRecord, peopleList) {
    for (const val of chatRecord) {
      if (val.side == <%= char.raidSide %>) {
        addMessage(val.userName, val.message);
      }
    }
    addPerson(peopleList);
  });
  
  socket.on('chat message', function(userName, msg, side) {
    if (side == <%= char.raidSide %>) {
      addMessage(userName, msg);
    }
  });
  
  socket.on('person left', function(peopleList) {
    addPerson(peopleList);
  });
  
  socket.on('tradeReq', function(suid, ouid, oname) {
    if (suid == '<%= user.uid %>') {
      showAlert(ouid, oname);
    }
  });
  
  function addMessage(userName, msg) {
    var ul = document.getElementById('messages'); if (!ul) return;
    var li = document.createElement('li');
    li.appendChild(document.createTextNode(userName + ' : ' + msg));
    ul.appendChild(li);
    ul.scrollTop = ul.scrollHeight;
  }
  
  function addPerson(peopleList) {
    var __c = document.getElementById('people'); if (!__c) return;
    var ul = document.getElementById('people');
    while (ul.lastChild) {
      ul.removeChild(ul.lastChild);
    }
    for (const val of peopleList) {
      var li = document.createElement('li');
      li.appendChild(document.createTextNode(val));
      ul.appendChild(li);
    }
  }
  
  function showAlert(ouid, oname) {
    if (false) {
    var alert = document.getElementById('alertBack');
    alert.style.display = 'block';
    var alertWin = document.getElementById('alertWindow');
    alertWin.children[0].innerText = '자리를 비운 동안 전투 신청을 받았습니다.';
    var alertForm = document.getElementById('tradeReqConfirm');
    alertForm.children[2].value = ouid;
    }
  }
  
  function hideAlert() {
    var alert = document.getElementById('alertBack');
    alert.style.display = 'none';
  }
      </script>
</head>
<body data-side="<%= (char && char.raidSide !== undefined) ? char.raidSide : '' %>">
<% 
  var printName = {};
  printName.maxHp = '생명력';
  printName.hpRegen = 'HP재생';
  printName.spRegen = 'SP재생';
  printName.spCharge = 'SP충전';
  printName.phyAtk = '물리공격력';
  printName.magAtk = '마법공격력';
  printName.crit = '치명';
  printName.critDmg = '치명피해';
  printName.phyReduce = '물리저항';
  printName.magReduce = '마법저항';
  printName.hit = '명중';
  printName.evasion = '회피';
  printName.dmgReduce = '피해감소';
  printName.pierce = '관통';
  printName.chanceEnh = '확률강화';
  printName[0] = '무기';
  printName[1] = '갑옷';
  printName[2] = '보조방어구';
  printName[3] = '장신구';
  printName[4] = '스킬 아티팩트';
  
  function getDamageText(skill) {
    var res = skill.type === 1 ? '물리' : '마법';
    return res + ' ' + skill.damage;
  }
  
  function getButtonText(rarity) {
    var cname = 'button';
    switch (rarity) {
    case 0:
      cname += 'Common';
      break;
    case 1:
      cname += 'Uncommon';
      break;
    case 2:
      cname += 'Rare';
      break;
    case 3:
      cname += 'Premium';
      break;
    case 4:
      cname += 'Unique';
      break;
    case 5:
      cname += 'Epic';
      break;
    }
    return cname;
  }
  
  function getRarityText(rarity) {
    var text = '';
    var cname = 'rarity';
    switch (rarity) {
    case 0:
      text = '커먼';
      cname += 'Common';
      break;
    case 1:
      text = '언커먼';
      cname += 'Uncommon';
      break;
    case 2:
      text = '레어';
      cname += 'Rare';
      break;
    case 3:
      text = '프리미엄';
      cname += 'Premium';
      break;
    case 4:
      text = '유니크';
      cname += 'Unique';
      break;
    case 5:
      text = '에픽';
      cname += 'Epic';
      break;
    }
    return '<span class="' + cname + '">' + text + '</span>';
  }
  
  function getStatList(val) {
    return Object.entries(val.stat).map(arr => { 
      if (arr[0] == 'phyAtkMin') {
        return  '물리공격력 +' + arr[1] + '~' + val.stat.phyAtkMax;
      } else if (arr[0] == 'magAtkMin') {
        return  '마법공격력 +' + arr[1] + '~' + val.stat.magAtkMax;        
      } else if (arr[0] == 'phyAtkMax' || arr[0] == 'magAtkMax') {
        return '';
      } else {
        var sign = arr[1] > 0 ? '+' : '';
        if (arr[0] == 'phyReduce' || arr[0] == 'magReduce' || arr[0] == 'crit' || arr[0] == 'critDmg' || arr[0] == 'crit' || arr[0] == 'hit' || arr[0] == 'evasion' || arr[0] == 'pierce') {
          arr[1] = (arr[1] * 100).toFixed(2) + '%'; 
        }
        return printName[arr[0]] + ' ' + sign + arr[1];
      }      
    }).filter(x => x.length > 0).join(', ');
  }
  
  function makeTooltip(item) {
    var rtext = '';
    rtext += item.name;
    if (item.type < 10) {
      rtext += '<br>' + item.rank + '급 ' + getRarityText(item.rarity) + ' ' + printName[item.type];
      if (item.setBonus) {
        rtext += '<br>세트 보너스 : ' + item.setBonus.name;
      }
      if (item.tradeCnt !== undefined) {
        rtext += '<br>거래횟수 : ' + item.tradeCnt;
      }
      rtext += '<br>' + getStatList(item);
      if (item.effectDesc && item.effectDesc.length > 0) {
        rtext += ', ' + item.effectDesc;
      }
      if (item.socket) {
        for (sock of item.socket) {
          if (sock) {
            rtext += '<br><br>[' + sock.name + '] ' + sock.effectDesc;
          }
        }
      }
      if (item.flavor && item.flavor.length > 0) {
        rtext += '<br><br><span class="tooltipFlavor">' + item.flavor + '</span>';
      }
    } else if (item.type == 999 && item.tooltip) {
      if (item.tradeCnt !== undefined) {
        rtext += '<br>거래횟수 : ' + item.tradeCnt;
      }
      rtext += '<br>' + item.tooltip + '<br>' + item.name[item.name.length - 2] + '요일에 일반 리설트 카드를 개봉했을 때 일정 확률로 획득할 수 있다.';
    } else if (item.type == 100 && item.tooltip) {
      rtext += '<br>' + item.tooltip;
    }
    return rtext;
  }
  
  function makeSkillTooltip(skill) {
    var rtext = '';
    rtext += skill.tooltip + '<br><br><span class="tooltipFlavor">' + skill.flavor + '</span>';
    return rtext;
  }
  
  if (!user) { %>
<main class="login-page">
  <div class="login-card">
    <div class="brand"><h1>ThirdWorld</h1><p>로그인이 필요합니다</p></div>
    <div class="actions">
      <a class="btn btn-primary" href="/login">로그인</a>
      <a class="btn" href="/join">가입</a>
    </div>
  </div>
</main>
  <% } else { %>
  <div class="alertBack" id="alertBack">
    <div id="alertWindow">
      <div></div>
      <div>
        <form id="tradeReqConfirm" action="/doTrade" method="post">
          <button type="submit" class="btn-primary">수락</button>
          <button type="button" onclick="hideAlert();">거절</button>
          <input type="hidden" name="charUid" value="" />
          <input type="hidden" name="mode" value="2" />
        </form>
      </div>
    </div>
  </div>

  <% if (char) {
       var sideName = char.raidSide == 0 ? '아리스란' : (char.raidSide == 1 ? '미네르프' : '');
       var sideMembers = char.raidSide == 0 ? '일룬드롤, 루니샤, 마랑, 가이우스 엠더츠, 뤼순 창' : (char.raidSide == 1 ? '이 눅스, 카시엔, 나백수, 세리어스 플로에르시아, 제이, 가비류이' : '');
       var winRate = (char.winCnt * 100 / (char.battleCnt ? char.battleCnt : 1)).toFixed(2);
       var glyph = ['✂', '●', '✋'];
  %>
<div class="page">

  <header class="nameplate">
    <div class="nameplate-main">
      <h1 class="name"><%= char.name %><small><%= char.title %></small></h1>
      <p class="sub"><%= char.level %>레벨<% if (rv) { %> · <b><%= rv.floor %>층</b> (<%= rv.cycle %>/<%= rv.total %>사이클) · <span style="color:var(--brass)"><%= rv.gold %> G</span> · <span style="color:var(--side-mine)">♥<%= rv.lives %></span><% } %><% if (sideName) { %> · <b class="has-tip"><%= sideName %> 공격대<div class="itemTooltip"><%= sideMembers %></div></b> · 공헌도 <%= char.raidEffort %><% } %></p>
    </div>
    <div class="nameplate-side">
      <span class="user"><%= user.name %></span>으로 접속<br>
      <a href="/logout">로그아웃</a>
    </div>
  </header>

  <div class="grid grid-main">

    <div class="grid">
      <section class="panel">
        <h2>캐릭터</h2>
        <table class="kv">
          <% if (char.run && char.run.buffs && char.run.buffs.length) { %>
          <tr><td class="k">일시 버프</td><td class="v"><% for (const b of char.run.buffs) { if (!b.label) continue; %><span style="color:var(--brass)"><%= b.label %></span> <small style="color:var(--ash)">(<%= b.battles %>전투)</small><br><% } %></td><td class="a"></td></tr>
          <% } %>
          <% if (char.run && char.run.breakpoint && !char.run.breakpointUsed) { %>
          <tr><td class="k">중단점</td><td class="v"><form action="/breakpoint" method="post" onsubmit="return confirm('이번 사이클 시작 시점으로 되돌아갑니다. 되돌릴 수 없습니다.')"><button type="submit" style="width:auto;min-height:0;padding:3px 10px;font-size:12px">이번 사이클 처음으로 되돌아간다</button></form></td><td class="a"></td></tr>
          <% } %>
          <tr><td class="k">스탯 포인트</td><td class="v"><%= char.statPoint %></td><td class="a"></td></tr>
          <tr><td class="k">전적</td><td class="v"><%= char.battleCnt %>전 <%= char.winCnt %>승 (<%= winRate %>%)</td><td class="a"></td></tr>
        </table>
      </section>

      <section class="panel">
        <h2>능력치</h2>
        <%
          var statRows = [];
          for ([key, val] of Object.entries(char.stat)) {
            if (key === 'phyAtkMax' || key === 'phyAtkMin' || key === 'magAtkMax' || key === 'magAtkMin') continue;
            var text;
            if (key === 'phyAtk' || key === 'magAtk') {
              text = (val + char.stat[key + 'Min']).toFixed(2) + '–' + (val + char.stat[key + 'Max']).toFixed(2);
            } else if (key == 'phyReduce' || key == 'magReduce' || key == 'crit' || key == 'critDmg' || key == 'hit' || key == 'evasion' || key == 'pierce' || key == 'chanceEnh') {
              text = (val * 100).toFixed(2) + '%';
            } else {
              text = val;
            }
            statRows.push({ key: key, label: (printName[key] ? printName[key] : key), text: text, main: (key === 'maxHp' || key === 'phyAtk' || key === 'magAtk') });
          }
        %>
        <table class="kv">
        <% const MAIN_ORDER = ['maxHp', 'phyAtk', 'magAtk']; const alloc = char.statAlloc || {};
           for (const r of statRows.filter(x => x.main).sort((a, b) => MAIN_ORDER.indexOf(a.key) - MAIN_ORDER.indexOf(b.key))) { %>
          <tr>
            <td class="k"><%= r.label %><% if (alloc[r.key]) { %> <small style="color:var(--ash)">(+<%= alloc[r.key] %>)</small><% } %></td>
            <td class="v"><%= r.text %></td>
            <td class="a">
              <% if (char.statPoint > 0) { %>
                <form action="/useStatPoint" method="post"><button type="submit">+</button><input type="hidden" name="keyType" value="<%= r.key %>"></form>
              <% } %>
            </td>
          </tr>
        <% } %>
        </table>
        <details class="fold">
          <summary>상세 능력치</summary>
          <table class="kv">
          <% for (const r of statRows.filter(x => !x.main)) { %>
            <tr><td class="k"><%= r.label %></td><td class="v"><%= r.text %></td><td class="a"></td></tr>
          <% } %>
          </table>
        </details>
      </section>


    </div>

    <div class="grid">
      <section class="panel">
        <h2>장비</h2>
        <% var slots = [['weapon','무기'],['armor','갑옷'],['subarmor','보조방어구'],['trinket','장신구'],['skillArtifact','스킬 아티팩트']];
           for (const [slot, label] of slots) { const it = char.items[slot]; %>
          <% if (it) { %>
          <div class="equip-row">
            <span class="slot"><%= label %></span>
            <span class="item has-tip"><span class="rank"><%= it.rank %>급</span><span class="<%= 'rarity' + ['Common','Uncommon','Rare','Premium','Unique','Epic'][it.rarity] %>"><%= it.name %></span>
              <div class="itemTooltip"><%- makeTooltip(it) %></div></span>
            <form action="/unequipItem" method="post"><button type="submit" class="btn-sm">해제</button><input type="hidden" name="itemType" value="<%= slot %>"></form>
          </div>
          <% } else { %>
          <div class="equip-row empty"><span class="slot"><%= label %></span><span class="item">— 비어 있음</span><span></span></div>
          <% } %>
        <% } %>
      </section>
      <section class="panel">
        <h2 class="sub-head">인벤토리</h2>
        <div class="inventory" id="inventory">
          <% for (const [key, val] of Object.entries(char.inventory)) { if (val) { %>
          <div class="inventoryItem">
            <form action="/useItem" method="post">
              <button class="<%= getButtonText(val.rarity) %> inventoryButton" onclick="invClick(this, event)" type="button"><%= val.name %>
                <div class="itemTooltip"><%- makeTooltip(val) %></div>
              </button>
              <input type="hidden" name="itemNum" value="<%= key %>">
            </form>
          </div>
          <% } } %>
        </div>
      </section>

      <section class="panel">
        <% var deckCounts = [0, 0, 0], deckExtra = [];
           if (char.deck) { for (const cd of char.deck) { if (cd.type >= 0 && cd.type <= 2) deckCounts[cd.type]++; else deckExtra.push(cd); } } %>
        <h2>스킬 · 덱<% if (char.deck) { %> <small style="color:var(--ash);font-weight:400"><%= char.deck.length %>장</small><% } %></h2>
        <div class="skills">
        <% for (let i = 0; i < 3; i++) { const sk = char.skill.base[i]; %>
          <div class="skill has-tip">
            <div class="glyph"><%= ['가위','바위','보'][i] %></div>
            <span class="sname"><%= sk.name %></span>
            <span class="sdmg"><%= getDamageText(sk) %></span>
            <% if (char.deck) { %><span class="count">× <%= deckCounts[i] %></span><% } %>
            <% const focusOn = char.items && Object.values(char.items).some(it => it && it.runEffect && it.runEffect.key === 'focusSkill'); if (focusOn) { %>
              <form action="/focusSkill" method="post" style="display:inline"><input type="hidden" name="idx" value="<%= i %>"><button type="submit" style="width:auto;min-height:0;padding:2px 8px;font-size:11px;<%= (char.run && char.run.focusSkill === i) ? 'border-color:var(--brass);color:var(--brass)' : '' %>" title="아리스란의 마지막 가르침"><%= (char.run && char.run.focusSkill === i) ? '집중 중' : '집중' %></button></form>
            <% } %>
            <% const rmAllow = (char.items && Object.values(char.items).some(it => it && it.runEffect && it.runEffect.key === 'removeCards')) ? Object.values(char.items).filter(it => it && it.runEffect && it.runEffect.key === 'removeCards').reduce((a, it) => a + it.runEffect.value, 0) : 0; const rmUsed = (char.run && char.run.cardRemovals) || 0;
               if (char.deck && rmAllow > rmUsed && deckCounts[i] > 0 && char.deck.length > 3) { %>
              <form action="/removeCard" method="post" style="display:inline"><input type="hidden" name="type" value="<%= i %>"><button type="submit" style="width:auto;min-height:0;padding:2px 8px;font-size:11px" title="마랑의 정리된 패 (남은 <%= rmAllow - rmUsed %>회)">제거</button></form>
            <% } %>
            <div class="itemTooltip"><%- makeSkillTooltip(sk) %></div>
          </div>
        <% } %>
        <% for (const cd of deckExtra) { %>
          <div class="skill special has-tip">
            <div class="glyph">특수</div>
            <span class="sname"><%= cd.name %></span>
            <% if (cd.tooltip) { %><div class="itemTooltip"><%- cd.tooltip %></div><% } %>
          </div>
        <% } %>
        </div>
        <% if (char.skill.special || char.skill.drive) { %>
        <div class="skills-extra">
          <% if (char.skill.special) { %>
          <div class="skill has-tip"><span><span class="glyph">스페셜</span> &nbsp;<%= char.skill.special.name %></span><span class="sdmg">SP <%= char.skill.special.cost %></span>
            <div class="itemTooltip"><%- makeSkillTooltip(char.skill.special) %></div></div>
          <% } %>
          <% if (char.skill.drive) { %>
          <div class="skill has-tip"><span><span class="glyph">드라이브</span> &nbsp;<%= char.skill.drive.name %></span><span class="sdmg">SP <%= char.skill.drive.cost %></span>
            <div class="itemTooltip"><%- makeSkillTooltip(char.skill.drive) %></div></div>
          <% } %>
        </div>
        <% } %>
      </section>
    </div>

  </div>

  <div class="grid grid-main" style="margin-top:16px">
    <div class="grid">
      <section class="panel">
        <h2>등반 소식</h2>
        <ul class="news"><% for (const val of news) { %><li><%- val %></li><% } %></ul>
        <% if (!news.length) { %><ul class="news"><li style="color:var(--ash)">아직 소식이 없다.</li></ul><% } %>
      </section>
      <section class="panel">
        <h2>획득 소식</h2>
        <ul class="news"><% for (const val of (typeof itemNews !== 'undefined' ? itemNews : [])) { %><li><%- val %></li><% } %></ul>
        <% if (typeof itemNews === 'undefined' || !itemNews.length) { %><ul class="news"><li style="color:var(--ash)">아직 뽑은 것이 없다.</li></ul><% } %>
      </section>
      <section class="panel">
        <h2>내 기록</h2>
        <ul class="news news-personal"><% for (const val of personalNews) { %><li><%- val %></li><% } %></ul>
      </section>
    </div>
    <div class="grid">
      <%# 채팅 패널 숨김 (로그라이크 단일 플레이) %>
      <section class="panel">
        <h2>행동</h2>
        <nav class="menu">
          <a href="/nextFloor" class="btn-next"><% if (rv) { %><%= rv.floor %>층 · <%= rv.stageLabel %><% } else { %>다음 층으로<% } %></a>
          <a href="/sortInventory">아이템 정리</a>
          <a href="/dismantlingYard">아이템 판매</a>
          <a href="/altar">해체의 제단</a>
          <a href="/viewItem">아이템 정보</a>
          <a href="/battleLogs">전투 기록</a>
          <a href="/hall">명예의 전당</a>
          <% if (char && char.run) { %>
          <form action="/abandonRun" method="post" onsubmit="return confirm('모험을 포기하고 이 캐릭터를 버립니다. 되돌릴 수 없습니다. 계속할까요?')" style="margin:0">
            <input type="hidden" name="confirm" value="ok">
            <button type="submit" class="quiet" style="width:100%;background:none;border:0;color:var(--ash);padding:8px 14px;text-align:left">모험 포기</button>
          </form>
          <% } %>
          <a href="/logout" class="quiet">로그아웃</a>
        </nav>
      </section>
    </div>
  </div>

</div>
  <% } else { %>
<main class="login-page">
