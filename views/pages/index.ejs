<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <script src="/socket.io/socket.io.js"></script>
    <script>
  function invClick(thisNode, event) {
    if (thisNode.type !== 'submit') {
      event.preventDefault();
      for (item of document.getElementsByClassName('inventoryButton')) {
        item.type = 'button';
      }
      thisNode.setAttribute('type', 'submit');
    }
  }
  
  var socket = io();
  socket.emit('login', '<%= user.name %>', '<%= user.uid %>', '<%= char.raidSide %>');
  
  function sendMessage() {
    socket.emit('chat message', document.getElementById('msg').value);
    document.getElementById('msg').value = '';
    return false;
  };
  
  socket.on('logged in', function(chatRecord, peopleList) {
    for (const val of chatRecord) {
      if (val.side == <%= char.raidSide %>) {
        addMessage(val.userName, val.message);
      }
    }
    addPerson(peopleList);
  });
  
  socket.on('chat message', function(userName, msg, side) {
    if (side == <%= char.raidSide %>) {
      addMessage(userName, msg);
    }
  });
  
  socket.on('person left', function(peopleList) {
    addPerson(peopleList);
  });
  
  socket.on('tradeReq', function(suid, ouid, oname) {
    if (suid == '<%= user.uid %>') {
      showAlert(ouid, oname);
    }
  });
  
  function addMessage(userName, msg) {
    var ul = document.getElementById('messages');
    var li = document.createElement('li');
    li.appendChild(document.createTextNode(userName + ' : ' + msg));
    ul.appendChild(li);
    ul.scrollTop = ul.scrollHeight;
  }
  
  function addPerson(peopleList) {
    var ul = document.getElementById('people');
    while (ul.lastChild) {
      ul.removeChild(ul.lastChild);
    }
    for (const val of peopleList) {
      var li = document.createElement('li');
      li.appendChild(document.createTextNode(val));
      ul.appendChild(li);
    }
  }
  
  function showAlert(ouid, oname) {
    if (false) {
    var alert = document.getElementById('alertBack');
    alert.style.display = 'block';
    var alertWin = document.getElementById('alertWindow');
    alertWin.children[0].innerText = '자리를 비운 동안 전투 신청을 받았습니다.';
    var alertForm = document.getElementById('tradeReqConfirm');
    alertForm.children[2].value = ouid;
    }
  }
  
  function hideAlert() {
    var alert = document.getElementById('alertBack');
    alert.style.display = 'none';
  }
      </script>
</head>
<body data-side="<%= (char && char.raidSide !== undefined) ? char.raidSide : '' %>">
<% 
  var printName = {};
  printName.maxHp = '생명력';
  printName.hpRegen = 'HP재생';
  printName.spRegen = 'SP재생';
  printName.spCharge = 'SP충전';
  printName.phyAtk = '물리공격력';
  printName.magAtk = '마법공격력';
  printName.crit = '치명';
  printName.critDmg = '치명피해';
  printName.phyReduce = '물리저항';
  printName.magReduce = '마법저항';
  printName.hit = '명중';
  printName.evasion = '회피';
  printName.dmgReduce = '피해감소';
  printName.pierce = '관통';
  printName.chanceEnh = '확률강화';
  printName[0] = '무기';
  printName[1] = '갑옷';
  printName[2] = '보조방어구';
  printName[3] = '장신구';
  printName[4] = '스킬 아티팩트';
  
  function getDamageText(skill) {
    var res = skill.type === 1 ? '물리' : '마법';
    return res + ' ' + skill.damage;
  }
  
  function getButtonText(rarity) {
    var cname = 'button';
    switch (rarity) {
    case 0:
      cname += 'Common';
      break;
    case 1:
      cname += 'Uncommon';
      break;
    case 2:
      cname += 'Rare';
      break;
    case 3:
      cname += 'Premium';
      break;
    case 4:
      cname += 'Unique';
      break;
    case 5:
      cname += 'Epic';
      break;
    }
    return cname;
  }
  
  function getRarityText(rarity) {
    var text = '';
    var cname = 'rarity';
    switch (rarity) {
    case 0:
      text = '커먼';
      cname += 'Common';
      break;
    case 1:
      text = '언커먼';
      cname += 'Uncommon';
      break;
    case 2:
      text = '레어';
      cname += 'Rare';
      break;
    case 3:
      text = '프리미엄';
      cname += 'Premium';
      break;
    case 4:
      text = '유니크';
      cname += 'Unique';
      break;
    case 5:
      text = '에픽';
      cname += 'Epic';
      break;
    }
    return '<span class="' + cname + '">' + text + '</span>';
  }
  
  function getStatList(val) {
    return Object.entries(val.stat).map(arr => { 
      if (arr[0] == 'phyAtkMin') {
        return  '물리공격력 +' + arr[1] + '~' + val.stat.phyAtkMax;
      } else if (arr[0] == 'magAtkMin') {
        return  '마법공격력 +' + arr[1] + '~' + val.stat.magAtkMax;        
      } else if (arr[0] == 'phyAtkMax' || arr[0] == 'magAtkMax') {
        return '';
      } else {
        var sign = arr[1] > 0 ? '+' : '';
        if (arr[0] == 'phyReduce' || arr[0] == 'magReduce' || arr[0] == 'crit' || arr[0] == 'critDmg' || arr[0] == 'crit' || arr[0] == 'hit' || arr[0] == 'evasion' || arr[0] == 'pierce') {
          arr[1] = (arr[1] * 100).toFixed(2) + '%'; 
        }
        return printName[arr[0]] + ' ' + sign + arr[1];
      }      
    }).filter(x => x.length > 0).join(', ');
  }
  
  function makeTooltip(item) {
    var rtext = '';
    rtext += item.name;
    if (item.type < 10) {
      rtext += '<br>' + item.rank + '급 ' + getRarityText(item.rarity) + ' ' + printName[item.type];
      if (item.setBonus) {
        rtext += '<br>세트 보너스 : ' + item.setBonus.name;
      }
      if (item.tradeCnt !== undefined) {
        rtext += '<br>거래횟수 : ' + item.tradeCnt;
      }
      rtext += '<br>' + getStatList(item);
      if (item.effectDesc && item.effectDesc.length > 0) {
        rtext += ', ' + item.effectDesc;
      }
      if (item.socket) {
        for (sock of item.socket) {
          if (sock) {
            rtext += '<br><br>[' + sock.name + '] ' + sock.effectDesc;
          }
        }
      }
      if (item.flavor && item.flavor.length > 0) {
        rtext += '<br><br><span class="tooltipFlavor">' + item.flavor + '</span>';
      }
    } else if (item.type == 999 && item.tooltip) {
      if (item.tradeCnt !== undefined) {
        rtext += '<br>거래횟수 : ' + item.tradeCnt;
      }
      rtext += '<br>' + item.tooltip + '<br>' + item.name[item.name.length - 2] + '요일에 일반 리설트 카드를 개봉했을 때 일정 확률로 획득할 수 있다.';
    } else if (item.type == 100 && item.tooltip) {
      rtext += '<br>' + item.tooltip;
    }
    return rtext;
  }
  
  function makeSkillTooltip(skill) {
    var rtext = '';
    rtext += skill.tooltip + '<br><br><span class="tooltipFlavor">' + skill.flavor + '</span>';
    return rtext;
  }
  
  if (!user) { %>
<main class="login-page">
  <div class="login-card">
    <div class="brand"><h1>ThirdWorld</h1><p>로그인이 필요합니다</p></div>
    <div class="actions">
      <a class="btn btn-primary" href="/login">로그인</a>
      <a class="btn" href="/join">가입</a>
    </div>
  </div>
</main>
  <% } else { %>
  <div class="alertBack" id="alertBack">
    <div id="alertWindow">
      <div></div>
      <div>
        <form id="tradeReqConfirm" action="/doTrade" method="post">
          <button type="submit" class="btn-primary">수락</button>
          <button type="button" onclick="hideAlert();">거절</button>
          <input type="hidden" name="charUid" value="" />
          <input type="hidden" name="mode" value="2" />
        </form>
      </div>
    </div>
  </div>

  <% if (char) {
       var sideName = char.raidSide == 0 ? '아리스란' : (char.raidSide == 1 ? '미네르프' : '');
       var sideMembers = char.raidSide == 0 ? '일룬드롤, 루니샤, 마랑, 가이우스 엠더츠, 뤼순 창' : (char.raidSide == 1 ? '이 눅스, 카시엔, 나백수, 세리어스 플로에르시아, 제이, 가비류이' : '');
       var winRate = (char.winCnt * 100 / (char.battleCnt ? char.battleCnt : 1)).toFixed(2);
       var glyph = ['✂', '●', '✋'];
  %>
<div class="page">

  <header class="nameplate">
    <div class="nameplate-main">
      <h1 class="name"><%= char.name %><small><%= char.title %></small></h1>
      <p class="sub"><%= char.rank %>급 <%= char.level %>레벨 · <b class="has-tip"><%= sideName %> 공격대<div class="itemTooltip"><%= sideMembers %></div></b> · 공헌도 <%= char.raidEffort %></p>
    </div>
    <div class="nameplate-side">
      <span class="user"><%= user.name %></span>으로 접속<br>
      <a href="/logout">로그아웃</a>
    </div>
  </header>

  <div class="grid grid-main">

    <div class="grid">
      <section class="panel">
        <h2>캐릭터</h2>
        <table class="kv">
          <tr>
            <td class="k">경험치</td>
            <td class="v has-tip"><%= char.exp %> / <%= char.reqExp %><span class="gauge"><i style="width:<%= Math.min(100, char.exp * 100 / (char.reqExp || 1)) %>%"></i></span>
              <div class="itemTooltip">현재 경험치 / 요구 경험치<br>오늘 획득 가능 잔여 경험치: <%= char.maxExp %><%= char.expBoost ? '<br>Boost ' + char.expBoost : '' %></div></td>
            <td class="a">
            <% if ((char.level >= 20 && char.rank > 7) || (char.level >= 25 && char.rank == 7)) { %>
              <form action="/doRankup" method="post"><button type="submit" <%= !char.rankReq ? 'disabled' : '' %>>랭크업</button></form>
            <% } %>
            </td>
          </tr>
          <tr>
            <td class="k">피로도</td>
            <td class="v"><%= actionPoint %> / 100<span class="gauge"><i style="width:<%= actionPoint %>%"></i></span></td>
            <td class="a">
              <form action="/actionAccel" method="post">
                <button onclick="invClick(this, event)" type="button" class="has-tip">가속 <%= char.actionAccel ? '끄기' : '켜기' %>
                  <div class="itemTooltip">가속을 켜면 PVP 전투에서 피로도를 2배 소모하고, 리설트 카드 게이지 획득 2배, 경험치 획득 +100%p. (부스트 등 추가 경험치는 2배가 되지 않음)</div>
                </button>
              </form>
            </td>
          </tr>
          <tr>
            <td class="k">카드 게이지</td>
            <td class="v has-tip"><%= char.resultGauge %> / 500<span class="gauge"><i style="width:<%= Math.min(100, char.resultGauge / 5) %>%"></i></span>
              <div class="itemTooltip">한 번에 최대 500까지 충전. 오늘 누적 <%= char.resultMaxGauge %>, 하루 2,500 초과 시 획득량 절반. 프리미엄 상점에서 누적 게이지 초기화 가능.</div></td>
            <td class="a">
            <% if (char.resultGauge >= 100) { %>
              <form action="/getCard" method="post"><button type="submit" class="btn-primary">카드 받기</button></form>
            <% } %>
            </td>
          </tr>
          <tr><td class="k">스탯 포인트</td><td class="v"><%= char.statPoint %></td><td class="a"></td></tr>
          <tr><td class="k">프리미엄 포인트</td><td class="v"><%= char.premiumPoint %></td><td class="a"></td></tr>
          <tr><td class="k">가루</td><td class="v"><%= char.dust %></td><td class="a"></td></tr>
          <tr><td class="k">전적</td><td class="v"><%= char.battleCnt %>전 <%= char.winCnt %>승 (<%= winRate %>%)<br><span style="color:var(--ash);font-size:12px">최근 50전 <%= char.recentRecord.filter(x => x).length %>승</span></td><td class="a"></td></tr>
        </table>
      </section>

      <section class="panel">
        <h2>능력치</h2>
        <table class="kv">
        <% for ([key, val] of Object.entries(char.stat)) {
             if (key === 'phyAtkMax' || key === 'phyAtkMin' || key === 'magAtkMax' || key === 'magAtkMin') continue; %>
          <tr>
            <td class="k"><%= (printName[key] ? printName[key] : key) %></td>
            <td class="v">
              <% if (key === 'phyAtk' || key === 'magAtk') { %>
                <%= (val + char.stat[key + 'Min']).toFixed(2) %>–<%= (val + char.stat[key + 'Max']).toFixed(2) %>
              <% } else {
                   if (key == 'phyReduce' || key == 'magReduce' || key == 'crit' || key == 'critDmg' || key == 'hit' || key == 'evasion' || key == 'pierce' || key == 'chanceEnh') {
                     val = (val * 100).toFixed(2) + '%';
                   } %>
                <%= val %>
              <% } %>
            </td>
            <td class="a">
              <% if ((key === 'maxHp' || key === 'phyAtk' || key === 'magAtk') && char.statPoint > 0 && char.lastStat != key) { %>
                <form action="/useStatPoint" method="post"><button type="submit">+</button><input type="hidden" name="keyType" value="<%= key %>"></form>
              <% } %>
            </td>
          </tr>
        <% } %>
        </table>
      </section>
    </div>

    <div class="grid">
      <section class="panel">
        <h2>장비</h2>
        <% var slots = [['weapon','무기'],['armor','갑옷'],['subarmor','보조방어구'],['trinket','장신구'],['skillArtifact','스킬 아티팩트']];
           for (const [slot, label] of slots) { const it = char.items[slot]; %>
          <% if (it) { %>
          <div class="equip-row">
            <span class="slot"><%= label %></span>
            <span class="item has-tip"><span class="rank"><%= it.rank %>급</span><span class="<%= 'rarity' + ['Common','Uncommon','Rare','Premium','Unique','Epic'][it.rarity] %>"><%= it.name %></span>
              <div class="itemTooltip"><%- makeTooltip(it) %></div></span>
            <form action="/unequipItem" method="post"><button type="submit" class="btn-sm">해제</button><input type="hidden" name="itemType" value="<%= slot %>"></form>
          </div>
          <% } else { %>
          <div class="equip-row empty"><span class="slot"><%= label %></span><span class="item">— 비어 있음</span><span></span></div>
          <% } %>
        <% } %>
      </section>

      <section class="panel">
        <h2>스킬</h2>
        <div class="skills">
        <% for (let i = 0; i < 3; i++) { const sk = char.skill.base[i]; %>
          <div class="skill has-tip">
            <div class="glyph"><%= ['가위','바위','보'][i] %></div>
            <span class="sname"><%= sk.name %></span>
            <span class="sdmg"><%= getDamageText(sk) %></span>
            <div class="itemTooltip"><%- makeSkillTooltip(sk) %></div>
          </div>
        <% } %>
        </div>
        <% if (char.skill.special || char.skill.drive) { %>
        <div class="skills-extra">
          <% if (char.skill.special) { %>
          <div class="skill has-tip"><span><span class="glyph">스페셜</span> &nbsp;<%= char.skill.special.name %></span><span class="sdmg">SP <%= char.skill.special.cost %></span>
            <div class="itemTooltip"><%- makeSkillTooltip(char.skill.special) %></div></div>
          <% } %>
          <% if (char.skill.drive) { %>
          <div class="skill has-tip"><span><span class="glyph">드라이브</span> &nbsp;<%= char.skill.drive.name %></span><span class="sdmg">SP <%= char.skill.drive.cost %></span>
            <div class="itemTooltip"><%- makeSkillTooltip(char.skill.drive) %></div></div>
          <% } %>
        </div>
        <% } %>
      </section>

      <section class="panel">
        <h2>인벤토리</h2>
        <div class="inventory" id="inventory">
          <% for (const [key, val] of Object.entries(char.inventory)) { if (val) { %>
          <div class="inventoryItem">
            <form action="/useItem" method="post">
              <button class="<%= getButtonText(val.rarity) %> inventoryButton" onclick="invClick(this, event)" type="button"><%= val.name %>
                <div class="itemTooltip"><%- makeTooltip(val) %></div>
              </button>
              <input type="hidden" name="itemNum" value="<%= key %>">
            </form>
          </div>
          <% } } %>
        </div>
      </section>
    </div>

  </div>

  <div class="grid grid-main" style="margin-top:16px">
    <div class="grid">
      <section class="panel">
        <h2>소식</h2>
        <ul class="news"><% for (const val of news) { %><li><%- val %></li><% } %></ul>
      </section>
      <section class="panel">
        <h2>내 기록</h2>
        <ul class="news news-personal"><% for (const val of personalNews) { %><li><%- val %></li><% } %></ul>
      </section>
    </div>
    <div class="grid">
      <section class="panel">
        <h2><%= sideName %> 공격대 채팅</h2>
        <div class="chat">
          <ul id="messages"></ul>
          <ul id="people"></ul>
          <form action="" name="chatForm" onsubmit="return sendMessage();">
            <input type="text" id="msg" placeholder="메시지 입력" autocomplete="off" />
            <button type="submit">보내기</button>
          </form>
        </div>
      </section>
      <section class="panel">
        <h2>행동</h2>
        <nav class="menu">
          <a href="/doBattle">전투 신청</a>
          <a href="/battleList">지정 전투 (<%= char.matchCount %>회 남음)</a>
          <a href="/dungeon">던전 입장</a>
          <a href="/quest">퀘스트</a>
          <a href="/doTest">허수아비</a>
          <a href="/battleLogs">전투 로그</a>
          <a href="/shop">상점</a>
          <a href="/tradeList">아이템 주기</a>
          <a href="/sortInventory">아이템 정리</a>
          <a href="/stoneCube">요일석 합성</a>
          <a href="/identifyingHall">아이템 감정</a>
          <a href="/dismantlingYard">아이템 해체</a>
          <a href="/viewList">캐릭터 정보</a>
          <a href="/viewItem">아이템 정보</a>
          <a href="/viewAch">업적</a>
          <a href="/logout" class="quiet">로그아웃</a>
        </nav>
      </section>
    </div>
  </div>

</div>
  <% } else { %>
<main class="login-page">
  <div class="login-card">
    <div class="brand"><h1>ThirdWorld</h1><p>캐릭터가 지정되지 않았습니다. 관리자에게 문의하세요.</p></div>
    <div class="actions"><span></span><a class="btn" href="/logout">로그아웃</a></div>
  </div>
</main>
  <% } %>
  <% } %>
<script src="/js/ui.js"></script>
</body>
</html>
