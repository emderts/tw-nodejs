<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld - 전투 로그</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
<div class="page-narrow">
  <div class="page-title"><h1>전투 로그</h1></div>
  <div class="list">
  <% for (val of list) { %>
    <div class="charItem">
      <form action="/battleLog" method="post">
        <button type="submit"><%= val.title %></button>
        <input type="hidden" name="logId" value="<%= val.id %>">
      </form>
      <div class="logDate"><%= val.date %></div>
    </div>
  <% } %>
  </div>
  <div class="backLink"><a href="/">돌아가기</a></div>
</div>
</body>
</html>
