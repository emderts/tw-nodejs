<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld - 로그인</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
  <main class="login-page">
    <div class="login-card">
      <div class="brand">
        <h1>ThirdWorld</h1>
      </div>
      <form action="/login" method="post">
        <input type="text" name="userId" placeholder="아이디" autocomplete="username" required />
        <input type="password" name="userPwd" placeholder="비밀번호" autocomplete="current-password" required />
        <div class="actions">
          <input type="submit" class="btn-primary" value="로그인" />
          <a class="btn" href="/join">가입</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
