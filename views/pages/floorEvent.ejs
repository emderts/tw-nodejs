<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#181c28">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="ThirdWorld">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <script>if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () {});</script>

  <title>ThirdWorld - 이벤트</title>
</head>
<body>
<div class="page-narrow">
  <%- include('../partials/runbar') %>
  <div class="page-title"><h1><%= ev.title %></h1></div>
  <div class="note-box"><%= ev.desc %></div>
  <% if (ev.html) { %><div class="note-box" style="border-color:var(--brass-dim)"><%- ev.html %></div><% } %>
  <% if (typeof canReroll !== 'undefined' && canReroll) { %>
  <form action="/floorEvent" method="post" style="margin:6px 0"><input type="hidden" name="action" value="reroll"><button type="submit" style="width:auto;min-height:0;padding:6px 12px;font-size:12px">예지 노트를 펼친다 — 다른 일이 일어난다</button></form>
  <% } %>
  <% if (done) { %>
    <div class="note-box" style="border-color:var(--brass-dim)"><%- done %></div>
    <form action="/floorEvent" method="post" class="backLink">
      <button type="submit" class="btn-primary" style="padding:12px 24px">계속 간다</button>
      <input type="hidden" name="action" value="leave">
    </form>
  <% } else { %>
    <div class="list">
    <% ev.options.forEach(function (o, i) { %>
      <div class="charItem">
        <form action="/floorEvent" method="post">
          <button type="submit"><%= o.label %></button>
          <input type="hidden" name="opt" value="<%= i %>">
        </form>
      </div>
    <% }); %>
    </div>
  <% } %>
  <div class="backLink"><a href="/">캐릭터 화면</a></div>
</div>
</body>
</html>
