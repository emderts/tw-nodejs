<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld - 리설트 카드</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <style>
      .card-stage { position: relative; width: 160px; height: 242px; margin: 40px auto 0; perspective: 800px; }
      .card-stage > div { position: absolute; inset: 0; width: 160px; height: 242px; border-radius: 10%; }
      .cardBack { transition: transform .6s; z-index: 2; cursor: pointer; }
      .cardBack img { width: 100%; height: 100%; object-fit: cover; border-radius: 10%; }
      .cardFront { z-index: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 12px; background: var(--slate); border: 1px solid var(--brass-dim); transition: box-shadow 1s; }
      .actualContent { position: relative; font-size: 14px; line-height: 1.6; }
      .actualContent .itemTooltip { left: 50%; transform: translateX(-50%); top: calc(100% + 12px); width: 260px; }
      .glowRare { box-shadow: 0 0 60px var(--r-rare); animation: pulse 2s infinite; --glow: var(--r-rare); }
      .glowUnique { box-shadow: 0 0 60px var(--r-unique); animation: pulse 2s infinite; --glow: var(--r-unique); }
      .glowEpic { box-shadow: 0 0 60px var(--r-epic); animation: pulse 2s infinite; --glow: var(--r-epic); }
      .shake { animation: shake 0.5s; animation-iteration-count: <%= item.rarity + 2 %>; }
      @keyframes shake {
        0% { transform: translate(1px, 1px) rotate(0deg); } 10% { transform: translate(-1px, -2px) rotate(-1deg); }
        20% { transform: translate(-3px, 0px) rotate(1deg); } 30% { transform: translate(3px, 2px) rotate(0deg); }
        40% { transform: translate(1px, -1px) rotate(1deg); } 50% { transform: translate(-1px, 2px) rotate(-1deg); }
        60% { transform: translate(-3px, 1px) rotate(0deg); } 70% { transform: translate(3px, 1px) rotate(-1deg); }
        80% { transform: translate(-1px, -1px) rotate(1deg); } 90% { transform: translate(1px, 2px) rotate(0deg); }
        100% { transform: translate(1px, -2px) rotate(-1deg); }
      }
      @keyframes pulse { 0%,100% { box-shadow: 0 0 60px var(--glow); } 50% { box-shadow: 0 0 30px var(--glow); } }
      .card-actions { margin-top: 24px; text-align: center; }
      .card-actions form { margin: 0 0 10px; }
  </style>
</head>
<body>
<%  
  var printName = {};
  printName.maxHp = '생명력';
  printName.hpRegen = 'HP재생';
  printName.spRegen = 'SP재생';
  printName.spCharge = 'SP충전';
  printName.phyAtk = '물리공격력';
  printName.magAtk = '마법공격력';
  printName.crit = '치명';
  printName.critDmg = '치명피해';
  printName.phyReduce = '물리저항';
  printName.magReduce = '마법저항';
  printName.hit = '명중';
  printName.evasion = '회피';
  printName.dmgReduce = '피해감소';
  printName.pierce = '관통';
  printName[0] = '무기';
  printName[1] = '갑옷';
  printName[2] = '보조방어구';
  printName[3] = '장신구';
  printName[4] = '스킬 아티팩트';
  
  function getRarityText(rarity) {
    var text = '';
    var cname = 'rarity';
    switch (rarity) {
    case 0:
      text = '커먼';
      cname += 'Common';
      break;
    case 1:
      text = '언커먼';
      cname += 'Uncommon';
      break;
    case 2:
      text = '레어';
      cname += 'Rare';
      break;
    case 3:
      text = '프리미엄';
      cname += 'Premium';
      break;
    case 4:
      text = '유니크';
      cname += 'Unique';
      break;
    case 5:
      text = '에픽';
      cname += 'Epic';
      break;
    }
    return '<span class="' + cname + '">' + text + '</span>';
  }
  
  function getStatList(val) {
    return Object.entries(val.stat).map(arr => { 
      if (arr[0] == 'phyAtkMin') {
        return  '물리공격력 +' + arr[1] + '~' + val.stat.phyAtkMax;
      } else if (arr[0] == 'magAtkMin') {
        return  '마법공격력 +' + arr[1] + '~' + val.stat.magAtkMax;        
      } else if (arr[0] == 'phyAtkMax' || arr[0] == 'magAtkMax') {
        return '';
      } else {
        var sign = arr[1] > 0 ? '+' : '';
        if (arr[0] == 'phyReduce' || arr[0] == 'magReduce' || arr[0] == 'crit' || arr[0] == 'critDmg' || arr[0] == 'crit' || arr[0] == 'hit' || arr[0] == 'evasion' || arr[0] == 'pierce') {
          arr[1] = (arr[1] * 100).toFixed(2) + '%'; 
        }
        return printName[arr[0]] + ' ' + sign + arr[1];
      }      
    }).filter(x => x.length > 0).join(', ');
  }
  
  function makeTooltip(item) {
    var rtext = '';
    rtext += item.name;
    if (item.type < 10) {
      rtext += '<br>' + item.rank + '급 ' + getRarityText(item.rarity) + ' ' + printName[item.type];
      rtext += '<br>' + getStatList(item);
      if (item.effectDesc && item.effectDesc.length > 0) {
        rtext += ', ' + item.effectDesc;
      }
    if (item.socket) {
      for (sock of item.socket) {
        rtext += '<br><br>[' + sock.name + '] ' + sock.effectDesc;
      }
    }
      if (item.flavor && item.flavor.length > 0) {
        rtext += '<br><br><span class="tooltipFlavor">' + item.flavor + '</span>';
      }
    }
    return rtext;
  }
  
  function getGlowText(rarity) {
    var cname = 'glow';
    switch (rarity) {
    case 0:
      cname += 'Common';
      break;
    case 1:
      cname += 'Uncommon';
      break;
    case 2:
      cname += 'Rare';
      break;
    case 3:
      cname += 'Premium';
      break;
    case 4:
      cname += 'Unique';
      break;
    case 5:
      cname += 'Epic';
      break;
    }
    return cname;
  }
%>
<script>
    function reveal() {
      document.getElementById('cardBack').setAttribute('style', 'transform: rotateY(180deg)');
      document.getElementById('cardBack').setAttribute('class', 'cardBack');
      document.getElementById('cardFront').setAttribute('class', 'cardFront <%= getGlowText(item.rarity) %> <%= item.rarity >= 2 ? 'shake' : '' %>');
      if (window.navigator.vibrate) {
        window.navigator.vibrate(1000);
      }
      setTimeout(function() {
        document.getElementById('cardBack').setAttribute('style', 'display: none');        
      }, 620);
      setTimeout(function() {
        document.getElementById('actualContent').setAttribute('style', 'visibility: visible; opacity : 1; transition: visibility 0s, opacity 0.5s linear;');
      document.getElementById('cardFront').setAttribute('class', 'cardFront <%= getGlowText(item.rarity) %>');        
      }, 420 + 200 * <%= item.rarity * item.rarity %>);
      document.getElementById('audio').play();
    }
    
  function invClick(thisNode, event) {
    if (thisNode.type !== 'submit') {
      event.preventDefault();
      for (item of document.getElementsByClassName('inventoryButton')) {
        item.type = 'button';
      }
      thisNode.setAttribute('type', 'submit');
    }
  }
  </script>
<div class="page-narrow">
  <div class="page-title"><h1>리설트 카드</h1><span class="meta">카드를 눌러 개봉</span></div>
<% if (item.rarity >= 4) { %>
    <audio id="audio" src="https://player.bgmstore.net/GpxUO/mp4" ></audio>
  <% } %>
  <div class="card-stage">
  <div class="cardBack" id="cardBack" onclick="reveal();">
    <img src="https://i.imgur.com/lFRuWeX.png" alt="카드 뒷면">
  </div>
  <div class="cardFront" id="cardFront">
    <span id="actualContent" class="actualContent has-tip" style="visibility: hidden; opacity : 0; transition: visibility 0s, opacity 0.5s linear;">
      <%- getRarityText(item.rarity) %><br>
      <%= item.name %>
      <div class="itemTooltip"><%- makeTooltip(item) %></div>
    </span>
  </div>
  </div>
  <div class="card-actions">
  <% if (remainCards && remainCards.length) { %>
    <div class="section-head" style="text-align:left">남은 리설트 카드 <small><%= remainCards.length %>장</small></div>
    <div class="list" style="text-align:left">
    <% for (const c of remainCards) { %>
      <div class="charItem">
        <form action="/useItem" method="post">
          <button type="submit"><%= c.name %> <span style="float:right;color:var(--brass)">개봉</span></button>
          <input type="hidden" name="itemNum" value="<%= c.idx %>">
        </form>
      </div>
    <% } %>
    </div>
  <% } %>
<div class="backLink"><a href="/">돌아가기</a></div>
  </div>

</div>
<script src="/js/ui.js"></script>
</body>
</html>
