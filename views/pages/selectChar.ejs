<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld - 캐릭터 선택</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#181c28">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="ThirdWorld">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <script>if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () {});</script>

  <style>
    .roster { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
    .char-card { background: var(--slate); border: 1px solid var(--line); border-radius: 4px; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
    .char-card.locked { opacity: .45; }
    .char-card .cname { margin: 0; font: 700 18px/1.25 var(--font-display); }
    .char-card .ctitle { color: var(--ash); font-size: 13px; margin-top: 2px; }
    .char-card .cskills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .char-card .cskills .skill { padding: 8px 6px; }
    .char-card .cskills .glyph { font-size: 12px; color: var(--ash); }
    .char-card .cskills .sname { font-size: 12.5px; margin-top: 4px; }
    .char-card .cskills .sdmg { font-size: 11.5px; }
    .char-card .cextra { display: grid; gap: 4px; font-size: 12.5px; color: var(--ash); }
    .char-card .cextra b { color: var(--parchment); font-weight: 500; }
    .char-card form { margin-top: auto; }
    .char-card form button { width: 100%; padding: 10px; }
    .lock-tag { font-size: 11.5px; color: var(--ash); text-align: center; padding: 8px; border: 1px dashed var(--line); border-radius: 3px; }
  </style>
</head>
<body>
<%
  function dmg(sk) { return (sk.type === 1 ? '물리' : '마법') + ' ' + sk.damage; }
%>
<div class="page">
  <div class="page-title">
    <h1><%= firstPick ? '시작 캐릭터 선택' : '캐릭터 선택' %></h1>
    <span class="meta"><%= user.name %> · <a href="/logout">로그아웃</a></span>
  </div>

  <% if (firstPick) { %>
  <div class="note-box">처음 고른 캐릭터가 해금됩니다. 이후에는 런을 클리어할 때마다 새 캐릭터가 무작위로 해금돼요.</div>
  <% } else { %>
  <div class="note-box">해금된 캐릭터 <b><%= unlocked.length %></b> / <%= roster.length %>. 잠긴 캐릭터는 런을 클리어하면 무작위로 해금돼요.</div>
  <% } %>
  <% if (typeof ascOpen !== 'undefined' && ascOpen > 0) { %>
  <div class="note-box">
    <label style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <b>승천</b>
      <select id="ascSel" style="width:auto;min-height:0;padding:4px 8px">
        <% for (let a = 0; a <= ascOpen; a++) { %><option value="<%= a %>" <%= a === ascOpen ? 'selected' : '' %>><%= a === 0 ? '승천 없음' : '승천 ' + a %></option><% } %>
      </select>
      <small style="color:var(--ash)">승천 N을 정복하면 N+1이 열립니다</small>
    </label>
    <div id="ascDesc" style="margin-top:8px;font-size:13px;color:var(--ash)"></div>
  </div>
  <script>
    (function () {
      var rules = <%- JSON.stringify(ascRules) %>;
      var sel = document.getElementById('ascSel'), box = document.getElementById('ascDesc');
      function draw() { var n = parseInt(sel.value, 10); var html = ''; for (var i = 1; i <= n; i++) html += '<div>' + i + '. ' + rules[i] + '</div>'; box.innerHTML = html || '일반 난이도'; document.querySelectorAll('input[name=asc]').forEach(function (x) { x.value = n; }); }
      sel.addEventListener('change', draw); draw();
      document.addEventListener('DOMContentLoaded', draw);   // 캐릭터 폼이 그려진 뒤에도 한 번 더 반영
    })();
  </script>
  <% } %>

  <div class="roster">
  <% const sorted = firstPick ? roster : roster.slice().sort(function (a, b) {
       return (unlocked.includes(b.key) ? 1 : 0) - (unlocked.includes(a.key) ? 1 : 0);
     });
     for (const c of sorted) {
       const isUnlocked = firstPick || unlocked.includes(c.key); %>
    <div class="char-card <%= isUnlocked ? '' : 'locked' %>">
      <div>
        <h2 class="cname"><%= c.name %></h2>
        <div class="ctitle"><%= c.title %> · <%= c.rank %>급</div>
      </div>
      <div class="cskills">
      <% c.skills.forEach(function (sk, i) { %>
        <div class="skill has-tip">
          <div class="glyph"><%= ['가위','바위','보'][i] %></div>
          <span class="sname"><%= sk.name %></span>
          <span class="sdmg"><%= dmg(sk) %></span>
          <div class="itemTooltip"><%- sk.tooltip %></div>
        </div>
      <% }); %>
      </div>
      <div class="cextra">
        <% if (c.special) { %><div class="has-tip">스페셜 <b><%= c.special.name %></b> (SP <%= c.special.cost %>)<div class="itemTooltip"><%- c.special.tooltip %></div></div><% } %>
        <% if (c.drive) { %><div class="has-tip">드라이브 <b><%= c.drive.name %></b><div class="itemTooltip"><%- c.drive.tooltip %></div></div><% } %>
      </div>
      <% if (isUnlocked) { %>
      <form action="/selectChar" method="post" onsubmit="var s=document.getElementById('ascSel'); if (s) this.asc.value = s.value;">
        <button type="submit" class="btn-primary"><%= firstPick ? '이 캐릭터로 시작' : '선택' %></button>
        <input type="hidden" name="charKey" value="<%= c.key %>">
        <input type="hidden" name="asc" value="<%= (typeof ascOpen !== 'undefined' ? ascOpen : 0) %>">
      </form>
      <% } else { %>
      <div class="lock-tag">잠김</div>
      <% } %>
    </div>
  <% } %>
  </div>
</div>
<script src="/js/ui.js"></script>
</body>
</html>
