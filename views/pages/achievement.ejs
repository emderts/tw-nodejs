<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld - 업적</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<%
  const printName = {damageDone : '총 입힌 피해', maxDamageDone : '최대 입힌 피해', maxDamageDoneTo : '최대 입힌 피해 대상', damageTaken : '총 입은 피해', maxDamageTaken : '최대 입은 피해', maxDamageTakenFrom : '최대 입은 피해를 준 캐릭터', atkCnt : '총 공격 횟수', atkRecvCnt : '총 피격 횟수', 
          lostLowerRank : '낮은 급수에 패배', wonHigherRank : '높은 급수에 승리', apUsed : '사용한 피로도', rareAmt : '레어 장비 획득', uniqueAmt : '유니크 장비 획득', epicAmt : '에픽 장비 획득', 
          cardUsed : '리설트 카드 개봉', dustAmt : '가루 획득', premiumAmt : '프리미엄 포인트 획득', maxHpStat : '생명력 스탯 포인트', phyAtkStat : '물리공격력 스탯 포인트', magAtkStat : '마법공격력 스탯 포인트'};
%>
<body>
<div class="page">
  <div class="page-title"><h1>업적</h1></div>
  <div class="table-scroll">
  <table class="data-table">
    <tr class="tblTitle">
      <td>#</td>
      <td>이름</td>
      <td>최초 달성</td>
      <td>내 달성일</td>
    </tr>
  <% for ([key, val] of Object.entries(achData)) { %>
    <tr class="<%= charAch[key] ? 'earned' : '' %>">
      <td><%= key %></td>
      <td><b><%= val.name %></b><br><span style="color:var(--ash);font-size:12.5px"><%= (val.hidden ? (charAch[key] ? val.desc : '???') : val.desc) %></span></td>
      <td class="muted"><%= (globalAch[key] ? (globalAch[key].date + ' (' + globalAch[key].holder + ')') : '미달성') %></td>
      <td><%= (charAch[key] ? charAch[key] : '미달성') %></td>
    </tr>
  <% } %>
  </table>
  </div>

  <h2 class="section-head">통계</h2>
  <table class="data-table">
  <% for ([key, val] of Object.entries(charStats)) { %>
    <tr>
      <td class="muted"><%= printName[key] %></td>
      <td><%= val %></td>
    </tr>
  <% } %>
  </table>
  <div class="backLink"><a href="/">돌아가기</a></div>
</div>
</body>
</html>
