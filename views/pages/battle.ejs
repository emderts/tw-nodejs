<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ThirdWorld - 전투</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
<div class="page-narrow battle-log">
  <div class="page-title"><h1>전투 결과</h1></div>
  <%- result %>
  <div class="backLink"><a href="/">돌아가기</a></div>
</div>
<script>
  document.addEventListener('click', function (e) {
    var t = e.target.closest('.has-tip, .inventoryItem button, .charItem button, .actualContent');
    document.querySelectorAll('.tip-open').forEach(function (el) { if (el !== t) el.classList.remove('tip-open'); });
    if (t && !e.target.closest('.itemTooltip') && t.querySelector('.itemTooltip')) t.classList.toggle('tip-open');
  });
</script>
</body>
</html>
